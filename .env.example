# Supabase project that holds the store's data (Project Settings > API).
SUPABASE_URL="https://your-project-ref.supabase.co"
# Server-only secret key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Required to enable the admin dashboard (/admin).
# Creates the admin password on first login attempt; change it later from Admin > Settings.
ADMIN_PASSWORD="choose-a-strong-password"
# Long random string used to sign admin sessions, e.g. the output of `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# Optional
# PORT=3000
